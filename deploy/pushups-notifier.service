[Unit]
Description=Pushup tracker web push sender
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pushups
Group=pushups
WorkingDirectory=/opt/pushups/notifier
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
MemoryMax=120M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
