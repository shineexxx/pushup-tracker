[Unit]
Description=Pushup tracker (PocketBase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pushups
Group=pushups
WorkingDirectory=/opt/pushups
ExecStart=/opt/pushups/pocketbase serve --http=127.0.0.1:8090
Restart=always
RestartSec=5
LimitNOFILE=4096
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/pushups

[Install]
WantedBy=multi-user.target
